---
import CourseCard from "./CourseCard";

interface Props {
  courses: Array<{
    id: string;
    title: string;
    description?: string;
    tags: string[];
    level: string;
    thumbnail?: string;
    comingSoon?: boolean;
  }>;
}

const { courses } = Astro.props;
const displayCourses = courses.slice(0, 4);
---

<section id="explore" class="px-12 py-20">
  <div class="box-container">
    <div class="flex items-end justify-between mb-8">
      <div>
        <div class="typo-label text-primary mb-2">
          All courses
        </div>
        <h2 class="typo-h2">
          Pick your next adventure
        </h2>
      </div>
      <a
        href="/explore"
        class="font-semibold text-primary no-underline hover:text-primary-hover transition-colors duration-150 shrink-0"
        >View all courses →</a
      >
    </div>

    <div class="flex gap-5 overflow-x-auto pb-4 -mx-1 px-1 scrollbar-hide">
      {
        displayCourses.map((course) => (
          <div class="shrink-0 w-[360px]">
            <CourseCard
              client:load
              title={course.title}
              description={course.description}
              tags={course.tags}
              thumbnail={course.thumbnail}
              href={course.comingSoon ? "#" : `/${course.id}`}
              level={
                course.comingSoon
                  ? "Coming Soon"
                  : course.tags[0] || "Adventure"
              }
              comingSoon={course.comingSoon}
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
