---
import CheatsheetCard from "./CheatsheetCard";

interface Props {
  cheatsheets: Array<{
    id: string;
    title: string;
    description?: string;
    tags: string[];
    href: string;
  }>;
}

const { cheatsheets } = Astro.props;
const displayCheatsheets = cheatsheets.slice(0, 4);
---

<section id="cheatsheets" class="px-4 sm:px-6 md:px-8 lg:px-12 py-12 sm:py-16 lg:py-20">
  <div class="box-container">
    <div
      class="flex flex-col sm:flex-row items-start sm:items-end justify-between mb-6 sm:mb-8 gap-3"
    >
      <div>
        <div class="typo-label text-primary mb-2">Cheatsheet</div>
        <h2 class="typo-h2">Quick reference for daily use</h2>
      </div>
      <a href="/explore-cheatsheets" class="typo-label text-primary shrink-0"
        >View all cheatsheets →</a
      >
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5"
    >
      {
        displayCheatsheets.map((cheatsheet) => (
          <CheatsheetCard
            client:load
            title={cheatsheet.title}
            description={cheatsheet.description}
            tags={cheatsheet.tags}
            href={cheatsheet.href}
          />
        ))
      }
    </div>
  </div>
</section>