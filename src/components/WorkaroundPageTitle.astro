---
import PageTitle from '@astrojs/starlight/components/PageTitle.astro';
import { tagHref } from '../data/workaround-tags';
import { isWorkaroundSource } from '../data/workaround-source';
import Badge from './ui/Badge.astro';

const { entry } = Astro.locals.starlightRoute;
---

<PageTitle />
{isWorkaroundSource(entry.filePath) && (
  <div class="flex flex-wrap gap-2 mt-3" aria-label="Workaround tags">
    {entry.data.tags?.map((tag) => (
      <Badge variant="primary" href={tagHref(tag)}>{tag}</Badge>
    ))}
  </div>
)}
