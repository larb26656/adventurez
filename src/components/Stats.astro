---
const stats = [
  { num: "No video", label: "required" },
  { num: "Read & build", label: "approach" },
  { num: "Free", label: "forever" },
  { num: "Open", label: "to contribute" },
];
---

<div class="px-4 sm:px-6 md:px-8 lg:px-12 bg-surface">
  <div class="box-container flex flex-col sm:flex-row border-y border-surface-alt">
    {
      stats.map((stat, i) => (
        <div class:list={["flex-1 py-5 sm:py-7 text-center border-b sm:border-b-0 sm:border-r border-surface-alt last:border-r-0 last:border-b-0"]}>
          <div class="typo-h3 mb-1">
            {stat.num}
          </div>
          <div class="typo-caption text-muted">{stat.label}</div>
        </div>
      ))
    }
  </div>
</div>
