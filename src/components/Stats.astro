---
const stats = [
  { num: "No video", label: "required" },
  { num: "Read & build", label: "approach" },
  { num: "Free", label: "forever" },
  { num: "Open", label: "to contribute" },
];
---

<div class="px-12 bg-surface">
  <div class="box-container flex border-y border-surface-alt">
    {
      stats.map((stat, i) => (
        <div class:list={["flex-1 py-7 text-center"]}>
          <div class="typo-h3 mb-1">
            {stat.num}
          </div>
          <div class="typo-caption text-muted">{stat.label}</div>
        </div>
      ))
    }
  </div>
</div>
