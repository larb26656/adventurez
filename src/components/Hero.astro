---
import Sprite from "./Sprite";
import Button from "./ui/Button.astro";

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section {id} class="px-4 sm:px-6 md:px-8 lg:px-12 py-12 sm:py-16 lg:py-20">
  <div
    class="box-container grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
  >
    <div>
      <h1
        class="typo-display text-foreground mb-4 sm:mb-5 text-[clamp(28px,6vw,48px)]"
      >
        <span class="italic font-light">The new way to learn</span>
        <span class="text-primary">something</span>
      </h1>
      <p class="typo-body text-muted max-w-[480px] mb-6 sm:mb-9">
        เปลี่ยนการเรียนให้เป็นเหมือนการผจญภัย พบกับคอร์สแบบ text-based
        ที่ทุกคนเข้าถึงได้ อ่านแล้วลงมือทำตามได้ทันที ~
      </p>

      <div class="flex gap-3 flex-wrap">
        <Button variant="primary" size="sm" href="#explore"
          >Explore courses →</Button
        >
      </div>
    </div>
    <div class="flex items-center justify-center">
      <div
        class="relative w-full max-w-[500px] aspect-[5/3] rounded-full overflow-hidden"
      >
        <img
          src="/misc/sea.png"
          alt="Sea"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-center">
          <img
            src="/misc/travel.png"
            alt="Travel"
            class="w-[60%] floating delay-1"
          />
        </div>
        <div class="absolute top-[35%] left-[15%] floating delay-2">
          <Sprite
            client:load
            src="misc/sprite/seagull_animation.png"
            frameWidth={32}
            frameHeight={32}
            cols={8}
            rows={1}
            fps={16}
          />
        </div>
        <div class="absolute top-[25%] right-[15%] floating delay-3">
          <Sprite
            client:load
            src="misc/sprite/seagull_animation.png"
            frameWidth={32}
            frameHeight={32}
            cols={8}
            rows={1}
            fps={16}
          />
        </div>
      </div>
    </div>
  </div>
</section>
