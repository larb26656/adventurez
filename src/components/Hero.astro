---
import Sprite from "./Sprite";
import Button from "./ui/Button.astro";

interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section {id} class="px-12 py-20">
  <div
    class="box-container grid grid-cols-1 lg:grid-cols-2 gap-16 items-center"
  >
    <div>
      <h1
        class="font-bold text-[clamp(40px,5vw,64px)] leading-[1.05] tracking-tight text-foreground mb-5"
        style="font-family: var(--font-display); letter-spacing: -0.02em;"
      >
        <span
          class="italic"
          style="font-family: var(--font-heading); font-style: italic; font-weight: 400;"
          >The new way to learn</span
        >
        <span class="text-primary">something</span>
      </h1>
      <p
        class="text-[17px] leading-[1.65] text-muted max-w-[480px] mb-9"
        style="font-family: var(--font-body);"
      >
        คอร์สแบบ text-based ล้วนๆ ที่ทุกคนเข้าถึงได้ — ไม่ต้องดูวิดีโอ
        ไม่ต้องมีพื้นฐาน อ่านแล้วลงมือทำได้เลย พร้อม community
        ที่ช่วยกันเขียนเนื้อหา
      </p>

      <div class="flex gap-3 flex-wrap">
        <Button variant="primary" size="sm" href="#explore"
          >Explore courses →</Button
        >
      </div>
    </div>
    <div class="flex items-center justify-center">
      <div class="relative w-[500px] h-[300px] rounded-full overflow-hidden">
        <img
          src="/misc/sea.png"
          alt="Sea"
          class="absolute inset-0 w-full h-full object-cover"
        />
        <div class="absolute inset-0 flex items-center justify-center">
          <img
            src="/misc/travel.png"
            alt="Travel"
            width="300px"
            class="floating delay-1"
          />
        </div>
        <div class="absolute top-35 left-20 floating delay-2">
          <Sprite
            client:load
            src="misc/sprite/seagull_animation.png"
            frameWidth={32}
            frameHeight={32}
            cols={8}
            rows={1}
            fps={16}
          />
        </div>
        <div class="absolute top-25 right-20 floating delay-3">
          <Sprite
            client:load
            src="misc/sprite/seagull_animation.png"
            frameWidth={32}
            frameHeight={32}
            cols={8}
            rows={1}
            fps={16}
          />
        </div>
      </div>
    </div>
  </div>
</section>
