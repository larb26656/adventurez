---
import Button from "./ui/Button.astro";
import Badge from "./ui/Badge.astro";

interface Props {
  workarounds: Array<{
    id: string;
    title: string;
    description?: string;
    tags: string[];
    publishedAt: string;
  }>;
}

const { workarounds } = Astro.props;
const displayWorkarounds = workarounds.slice(0, 3);
---

<section
  id="workarounds"
  class="px-4 sm:px-6 md:px-8 lg:px-12 py-12 sm:py-16 lg:py-20"
>
  <div
    class="box-container grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.3fr)] gap-8 lg:gap-12 items-start"
  >
    <div class="lg:sticky lg:top-24">
      <div class="typo-label text-primary mb-2">Workaround</div>
        <h2 class="typo-h2 mb-3 sm:mb-4">Real fixes from the field</h2>
      <p class="typo-body text-muted mb-5 sm:mb-7 max-w-[36ch]">
        รวมวิธีแก้ปัญหาที่เจอตอนใช้งานจริง เน้นทำตามได้ทันที
      </p>
      <Button variant="primary" size="sm" href="/workarounds/"
        >View all workarounds →</Button
      >
    </div>

    <ul class="list-none m-0 p-0 flex flex-col gap-3 sm:gap-4">
      {
        displayWorkarounds.map((workaround) => (
          <li>
            <a
              href={`/${workaround.id}/`}
              class="group block bg-white border border-border rounded-xl p-5 sm:p-6 no-underline text-inherit transition-all duration-200 hover:shadow-lg hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-primary focus-visible:outline-offset-2"
            >
              <h3 class="typo-card-title text-foreground mb-2 group-hover:text-primary transition-colors">
                {workaround.title}
              </h3>
              {workaround.description && (
                <p class="typo-body-sm text-muted line-clamp-2 mb-0">
                  {workaround.description}
                </p>
              )}
              {workaround.tags.length > 0 && (
                <div class="flex gap-1.5 flex-wrap mt-3">
                  {workaround.tags.slice(0, 3).map((tag) => (
                    <Badge variant="primary">{tag}</Badge>
                  ))}
                </div>
              )}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
