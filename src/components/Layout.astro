---
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import "../styles/adventurez.css";

interface Props {
  title?: string;
  active?: string;
  showCta?: boolean;
}

const { title = "adventurez", active = "Home", showCta = false } = Astro.props;
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title><link
      rel="preconnect"
      href="https://fonts.googleapis.com"
    /><link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin=""
    /><link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=VT323&display=swap"
      rel="stylesheet"
    /></head
  >
</html>
<body>
  <Nav active={active} showCta={showCta} />
  <slot />
  <Footer />
</body>
