---
import Button from "./ui/Button.astro";
import FeatureItem from "./ui/FeatureItem.astro";
---

<section class="px-12 py-20">
  <div
    class="box-container grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
  >
    <div>
      <div class="font-heading text-sm text-primary font-bold mb-2">
        Community
      </div>
      <h2 class="font-display text-4xl font-semibold mb-6">
        Help write the next adventure
      </h2>
      <p class="text-muted mb-7">
        Adventurez เป็น open-source project ที่ทุกคนช่วยกันสร้างเนื้อหาได้
        ตั้งแต่เขียนคอร์สใหม่, แก้ไขเนื้อหา, ไปจนถึงเพิ่มตัวอย่างโค้ด
      </p>
      <ul class="flex flex-col gap-4 list-none m-0 p-0 mb-7">
        <FeatureItem
          icon="1"
          title="Fork the repo"
          description="clone แล้วเลือก course ที่อยากเขียน"
          numbered
        />
        <FeatureItem
          icon="2"
          title="เขียนเนื้อหา"
          description="text-based, markdown ล้วน ไม่มีวิดีโอ"
          numbered
        />
        <FeatureItem
          icon="3"
          title="เปิด PR"
          description="community review แล้ว merge เข้า main"
          numbered
        />
      </ul>
      <Button
        variant="primary"
        size="sm"
        href="https://github.com/larb26656/adventurez"
        class="mt-6">Contribute on GitHub →</Button
      >
    </div>
    <div class="flex items-center justify-center">
      <img src="/misc/contribute.png" alt="Contribute" width="450px" />
    </div>
  </div>
</section>
