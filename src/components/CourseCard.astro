---
interface Props {
  title: string;
  tag?: string;
  pixelArt?: string;
  href: string;
  level?: string;
  duration?: string;
  rating?: string;
  price?: string;
}

const { 
  title, 
  tag = "Adventure", 
  pixelArt = "░░██░░\n░░██░░\n░████░\n░░██░░\n░░██░░",
  href, 
  level = "Beginner", 
  duration = "3 hrs", 
  rating = "★ 4.8",
  price = "Free"
} = Astro.props;
---

<a class="course-card" href={href}>
  <div class="course-thumb">
    <div class="pixel-art">{pixelArt}</div>
  </div>
  <div class="course-body">
    <div class="course-tag">{tag}</div>
    <div class="course-title">{title}</div>
    <div class="course-meta">
      <span>{level}</span>
      <span>{duration}</span>
      <span>{rating}</span>
    </div>
    <div class="course-footer">
      <div class="course-free">{price}</div>
      <button class="course-btn">Start</button>
    </div>
  </div>
</a>