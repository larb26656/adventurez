---
const footerLinks = [
  { label: "Contribute", href: "https://github.com/larb26656/adventurez" },
  { label: "Course requests", href: "https://github.com/larb26656/adventurez" },
  { label: "Bug reports", href: "https://github.com/larb26656/adventurez" },
];
---

<footer
  class="border-t border-border py-6 sm:py-8 px-4 sm:px-6 md:px-8 lg:px-12"
>
  <div
    class="box-container flex flex-col sm:flex-row items-center justify-between gap-3"
  >
    <p class="typo-caption text-muted text-center sm:text-left">
      © 2026 adventurez — <span class="text-primary font-semibold"
        ><a href="https://github.com/larb26656/adventurez"></a>open source</span
      > on GitHub
    </p>
    <p class="typo-caption text-muted text-center sm:text-right">
      {
        footerLinks.map((link, i) => (
          <>
            <a href={link.href} class="hover:text-primary transition-colors">
              {link.label}
            </a>
            {i < footerLinks.length - 1 && " · "}
          </>
        ))
      }
    </p>
  </div>
</footer>
