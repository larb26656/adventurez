---
const footerLinks = [
  { label: "Contribute", href: "#" },
  { label: "Course requests", href: "#" },
  { label: "Bug reports", href: "#" },
];
---

<footer class="border-t border-border py-8 px-12">
  <div class="box-container flex items-center justify-between">
    <p class="typo-caption text-muted">
      © 2026 adventurez — <span class="text-primary font-semibold"
        ><a href="https://github.com/larb26656/adventurez"></a>open source</span
      > on GitHub
    </p>
    <p class="typo-caption text-muted">
      {
        footerLinks.map((link, i) => (
          <>
            <a href={link.href} class="hover:text-primary transition-colors">
              {link.label}
            </a>
            {i < footerLinks.length - 1 && " · "}
          </>
        ))
      }
    </p>
  </div>
</footer>
