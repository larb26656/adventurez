---
const footerLinks = [
  { label: "Contribute", href: "#" },
  { label: "Course requests", href: "#" },
  { label: "Bug reports", href: "#" },
];
---

<footer class="border-t border-dashed border-border py-8 px-12 flex items-center justify-between max-w-[1100px] mx-auto">
  <p class="text-[13px] text-muted">© 2026 adventurez — <span class="text-primary font-semibold">open source</span> on GitHub</p>
  <p class="text-[12px] text-muted">
    {footerLinks.map((link, i) => (
      <>
        <a href={link.href} class="hover:text-primary transition-colors">{link.label}</a>
        {i < footerLinks.length - 1 && " · "}
      </>
    ))}
  </p>
</footer>