---
interface Props {
  active?: string;
  showCta?: boolean;
}
const { active = "Home" } = Astro.props;
---

<nav
  class="sticky top-0 left-0 right-0 z-50 flex items-center justify-between px-12 py-5 border-b border-stone-200 bg-white/80 backdrop-blur-md"
>
  <a
    class="font-serif font-bold text-[22px] tracking-tight text-stone-800 no-underline"
    href="/">adventure<span class="text-emerald-600">z</span></a
  >
  <ul class="flex gap-8 list-none m-0 p-0">
    <li>
      <a
        href="/"
        class:list={[
          "no-underline text-[14px] font-medium transition-colors duration-150",
          active === "Home"
            ? "text-stone-800"
            : "text-stone-500 hover:text-stone-800",
        ]}>Home</a
      >
    </li>
    <li>
      <a
        href="/explore"
        class:list={[
          "no-underline text-[14px] font-medium transition-colors duration-150",
          active === "Courses"
            ? "text-stone-800"
            : "text-stone-500 hover:text-stone-800",
        ]}>Courses</a
      >
    </li>
    <li>
      <a
        href="/path"
        class:list={[
          "no-underline text-[14px] font-medium transition-colors duration-150",
          active === "Paths"
            ? "text-stone-800"
            : "text-stone-500 hover:text-stone-800",
        ]}>Paths</a
      >
    </li>
    <li>
      <a
        href="#"
        class="no-underline text-[14px] font-medium text-stone-500 hover:text-stone-800 transition-colors duration-150"
        >Community</a
      >
    </li>
  </ul>
</nav>
