---
import "../styles/adventurez.css";
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>adventurez — Learning Paths</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="" />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&family=VT323&display=swap" rel="stylesheet" />
  </head>
  <body>

    <nav>
      <a class="logo" href="/">adventure<span>z</span></a>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/explore">Courses</a></li>
        <li><a href="/path" class="active">Paths</a></li>
        <li><a href="#">Community</a></li>
      </ul>
      <a class="btn-cta" href="#">Start learning</a>
    </nav>

    <div class="path-header">
      <h1><span class="italic-accent">Chart your</span> own route</h1>
      <p>สร้าง learning path ของตัวเอง — เลือกคอร์สเรียงลำดับ ตั้งเป้าหมาย แล้วค่อยๆ ทำทีละขั้น ข้อมูลเก็บในเครื่อง ไม่ต้องสมัคร</p>
    </div>

    <div class="path-shell">

      <!-- Left: My Paths -->
      <div class="paths-list">
        <div class="paths-list-header">
          <h2>My Paths</h2>
          <button class="btn-new-path" id="btnNewPath">+ New</button>
        </div>
        <div id="paths-list-body">
          <!-- rendered by JS -->
        </div>
      </div>

      <!-- Right: Path Detail -->
      <div class="path-detail" id="path-detail">
        <div class="path-detail-empty">
          <div class="icon">🗺️</div>
          <h3>Select or create a path</h3>
          <p>เลือก path ด้านซ้าย หรือสร้างใหม่เพื่อเริ่มวางแผนการเรียน</p>
        </div>
      </div>

    </div>

    <!-- Create Path Modal -->
    <div class="modal-overlay" id="modal-overlay">
      <div class="modal">
        <h3>Create a new path</h3>
        <p>ตั้งชื่อ path แล้วอธิบายเป้าหมาย — จะเก็บไว้ในเครื่องเท่านั้น</p>
        <label for="path-name">Path name</label>
        <input type="text" id="path-name" placeholder="e.g. Road to Frontend Developer" />
        <label for="path-desc">Description (optional)</label>
        <textarea id="path-desc" placeholder="เป้าหมายของ path นี้…"></textarea>
        <div class="modal-actions">
          <button class="modal-cancel" id="modalCancel">Cancel</button>
          <button class="modal-save" id="modalSave">Create path</button>
        </div>
      </div>
    </div>

    <footer>
      <p>© 2026 adventurez — <span>open source</span> on GitHub</p>
      <p style="font-size:12px;">All data stored locally in your browser</p>
    </footer>

    <style>
      .path-header {
        max-width: 1100px;
        margin: 0 auto;
        padding: 56px 48px 32px;
      }
      .path-header h1 {
        font: 800 clamp(32px, 4vw, 48px)/1.1 var(--font-display);
        letter-spacing: -0.02em;
        margin-bottom: 12px;
      }
      .path-header h1 .italic-accent {
        font-family: var(--font-heading);
        font-style: italic;
        font-weight: 400;
      }
      .path-header p {
        font: 17px/1.6 var(--font-body);
        color: var(--muted);
        max-width: 520px;
      }

      .path-shell {
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 48px 80px;
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 32px;
        align-items: start;
      }

      .paths-list {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        position: sticky;
        top: 24px;
      }
      .paths-list-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 20px;
        border-bottom: 1px dashed var(--border);
      }
      .paths-list-header h2 {
        font: 700 14px/1 var(--font-display);
        letter-spacing: -0.01em;
      }
      .btn-new-path {
        background: var(--accent);
        color: oklch(98% 0.008 85);
        border: none;
        border-radius: 6px;
        padding: 6px 12px;
        font: 600 12px/1 var(--font-body);
        cursor: pointer;
        transition: background 0.15s;
      }
      .btn-new-path:hover { background: var(--accent-hover); }

      .path-item {
        padding: 14px 20px;
        border-bottom: 1px dashed var(--border);
        cursor: pointer;
        transition: background 0.12s;
      }
      .path-item:last-child { border-bottom: none; }
      .path-item:hover { background: var(--surface-alt); }
      .path-item.selected {
        background: var(--accent-dim);
        border-left: 3px solid var(--accent);
      }
      .path-item-title {
        font: 600 14px/1.3 var(--font-display);
        margin-bottom: 4px;
      }
      .path-item-meta {
        font: 12px/1 var(--font-body);
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .path-progress-bar {
        width: 100%;
        height: 4px;
        background: var(--border);
        border-radius: 2px;
        margin-top: 8px;
        overflow: hidden;
      }
      .path-progress-fill {
        height: 100%;
        background: var(--accent);
        border-radius: 2px;
        transition: width 0.3s;
      }
      .path-progress-fill.complete { background: var(--success); }

      .path-empty {
        padding: 32px 20px;
        text-align: center;
        color: var(--muted);
        font: 13px/1.5 var(--font-body);
      }

      .path-detail {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
      }
      .path-detail-header {
        padding: 24px 28px;
        border-bottom: 1px dashed var(--border);
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }
      .path-detail-title {
        font: 700 22px/1.2 var(--font-display);
        letter-spacing: -0.01em;
        margin-bottom: 4px;
      }
      .path-detail-desc {
        font: 14px/1.5 var(--font-body);
        color: var(--muted);
      }
      .path-detail-actions { display: flex; gap: 8px; flex-shrink: 0; }
      .btn-sm {
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 6px 14px;
        font: 600 12px/1 var(--font-body);
        cursor: pointer;
        transition: all 0.12s;
        color: var(--fg);
      }
      .btn-sm:hover { border-color: var(--accent); color: var(--accent); }
      .btn-sm.danger { color: oklch(55% 0.18 25); }
      .btn-sm.danger:hover { background: oklch(55% 0.18 25 / 0.08); }

      .course-sequence { padding: 20px 28px 28px; }
      .sequence-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 16px 0;
        border-bottom: 1px dashed var(--border);
      }
      .sequence-item:last-child { border-bottom: none; }

      .sequence-check {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        border: 2px solid var(--border);
        display: grid;
        place-items: center;
        flex-shrink: 0;
        cursor: pointer;
        transition: all 0.15s;
        margin-top: 2px;
        background: var(--surface);
      }
      .sequence-check:hover { border-color: var(--accent); }
      .sequence-check.done {
        background: var(--success);
        border-color: var(--success);
        color: white;
      }
      .sequence-check.done::after { content: '✓'; font-size: 14px; font-weight: 700; }

      .sequence-body { flex: 1; }
      .sequence-num {
        font: 10px/1 var(--font-pixel);
        letter-spacing: 0.1em;
        color: var(--muted);
        margin-bottom: 2px;
      }
      .sequence-title {
        font: 600 15px/1.3 var(--font-display);
        margin-bottom: 2px;
      }
      .sequence-meta {
        font: 12px/1 var(--font-body);
        color: var(--muted);
      }
      .sequence-remove {
        background: none;
        border: none;
        color: var(--muted);
        cursor: pointer;
        font-size: 16px;
        padding: 4px;
        transition: color 0.12s;
        flex-shrink: 0;
      }
      .sequence-remove:hover { color: oklch(55% 0.18 25); }

      .add-course-section {
        padding: 20px 28px;
        border-top: 1px dashed var(--border);
      }
      .add-course-label {
        font: 11px/1 var(--font-body);
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 12px;
      }
      .add-course-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 10px;
      }
      .add-course-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px 14px;
        background: var(--surface-alt);
        border: 1px dashed var(--border);
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.12s;
        font: 13px/1.3 var(--font-body);
        color: var(--fg);
      }
      .add-course-btn:hover {
        border-color: var(--accent);
        border-style: solid;
        background: var(--accent-dim);
      }
      .add-course-btn.added {
        opacity: 0.4;
        pointer-events: none;
      }
      .add-course-btn .plus {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--accent-dim);
        color: var(--accent);
        display: grid;
        place-items: center;
        font-size: 14px;
        flex-shrink: 0;
      }

      .achievement-badge {
        margin: 20px 28px;
        padding: 20px 24px;
        background: var(--success-dim);
        border: 1px solid oklch(62% 0.16 145 / 0.2);
        border-radius: 10px;
        display: none;
        align-items: center;
        gap: 14px;
      }
      .achievement-badge.visible { display: flex; }
      .achievement-icon {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--success);
        display: grid;
        place-items: center;
        font-size: 22px;
        flex-shrink: 0;
      }
      .achievement-text {
        font: 14px/1.5 var(--font-body);
      }
      .achievement-text strong {
        font: 700 15px/1.3 var(--font-display);
        display: block;
        margin-bottom: 2px;
      }

      .modal-overlay {
        position: fixed;
        inset: 0;
        background: oklch(25% 0.04 45 / 0.4);
        backdrop-filter: blur(4px);
        display: none;
        place-items: center;
        z-index: 1000;
      }
      .modal-overlay.open { display: grid; }
      .modal {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 32px;
        width: 100%;
        max-width: 440px;
      }
      .modal h3 {
        font: 700 20px/1.2 var(--font-display);
        margin-bottom: 8px;
      }
      .modal p {
        font: 14px/1.5 var(--font-body);
        color: var(--muted);
        margin-bottom: 24px;
      }
      .modal label {
        display: block;
        font: 600 13px/1 var(--font-body);
        margin-bottom: 6px;
      }
      .modal input, .modal textarea {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font: 14px/1.5 var(--font-body);
        background: var(--bg);
        color: var(--fg);
        margin-bottom: 16px;
        outline: none;
        transition: border-color 0.12s;
      }
      .modal input:focus, .modal textarea:focus { border-color: var(--accent); }
      .modal textarea { resize: vertical; min-height: 60px; }
      .modal-actions { display: flex; gap: 10px; justify-content: flex-end; }
      .modal-cancel {
        background: var(--surface-alt);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px 18px;
        font: 600 14px/1 var(--font-body);
        cursor: pointer;
        color: var(--fg);
      }
      .modal-save {
        background: var(--accent);
        color: oklch(98% 0.008 85);
        border: none;
        border-radius: 8px;
        padding: 8px 22px;
        font: 600 14px/1 var(--font-body);
        cursor: pointer;
        transition: background 0.15s;
      }
      .modal-save:hover { background: var(--accent-hover); }

      .path-detail-empty {
        padding: 64px 28px;
        text-align: center;
        color: var(--muted);
      }
      .path-detail-empty .icon {
        font-size: 48px;
        margin-bottom: 16px;
        opacity: 0.5;
      }
      .path-detail-empty h3 {
        font: 700 18px/1.3 var(--font-display);
        color: var(--fg);
        margin-bottom: 8px;
      }

      @media (max-width: 900px) {
        .path-shell { grid-template-columns: 1fr; }
        .paths-list { position: static; }
        .path-header { padding: 40px 24px 24px; }
        .path-shell { padding: 0 24px 64px; }
      }
    </style>

    <script>
      interface Path {
        id: string;
        name: string;
        desc: string;
        courses: string[];
        completed: string[];
        created: string;
      }

      const COURSES = [
        { id: 'react-leaflet', title: 'Build a Map Explorer with React + Leaflet', tag: 'Web Dev', duration: '3 hrs' },
        { id: 'godot-platformer', title: 'Create a 2D Platformer with Godot', tag: 'Game Dev', duration: '2.5 hrs' },
        { id: 'serverless-api', title: 'Serverless API with AWS Lambda + Node', tag: 'Backend', duration: '4 hrs' },
        { id: 'css-grid', title: 'CSS Grid + Flexbox Layout Masterclass', tag: 'Web Dev', duration: '1 hr' },
        { id: 'js-fundamentals', title: 'JavaScript Fundamentals for Beginners', tag: 'Web Dev', duration: '2 hrs' },
        { id: 'python-basics', title: 'Python Basics — Write Your First Script', tag: 'Backend', duration: '1.5 hrs' },
        { id: 'git-workflow', title: 'Git + GitHub Workflow for Teams', tag: 'Dev Tools', duration: '1 hr' },
        { id: 'react-basics', title: 'React from Zero — Components + State', tag: 'Web Dev', duration: '3 hrs' },
        { id: 'node-express', title: 'Build a REST API with Node + Express', tag: 'Backend', duration: '3.5 hrs' },
        { id: 'tailwind-css', title: 'Style Fast with Tailwind CSS', tag: 'Web Dev', duration: '1.5 hrs' },
        { id: 'threejs-intro', title: '3D on the Web — Three.js Introduction', tag: 'Creative', duration: '2.5 hrs' },
        { id: 'sql-basics', title: 'SQL Basics — Query Your First Database', tag: 'Data', duration: '2 hrs' },
      ];

      const STORAGE_KEY = 'adventurez:paths';

      function loadPaths(): Path[] {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]') as Path[];
        } catch { return []; }
      }
      function savePaths(paths: Path[]) {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(paths));
      }

      let paths: Path[] = loadPaths();
      let selectedPathId: string | null = null;

      function esc(s: string): string {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
      }

      function renderPathsList() {
        const body = document.getElementById('paths-list-body')!;
        if (paths.length === 0) {
          body.innerHTML = '<div class="path-empty">No paths yet.<br/>Click <strong>+ New</strong> to create one.</div>';
          return;
        }
        body.innerHTML = paths.map((p: Path) => {
          const total = p.courses.length;
          const done = p.completed ? p.completed.length : 0;
          const pct = total > 0 ? Math.round((done / total) * 100) : 0;
          const isComplete = total > 0 && done === total;
          return `
            <div class="path-item ${p.id === selectedPathId ? 'selected' : ''}" data-path-id="${p.id}">
              <div class="path-item-title">${esc(p.name)}</div>
              <div class="path-item-meta">
                <span>${total} courses</span>
                <span>·</span>
                <span>${done}/${total}</span>
                ${isComplete ? '<span>· 🏆</span>' : ''}
              </div>
              <div class="path-progress-bar">
                <div class="path-progress-fill ${isComplete ? 'complete' : ''}" style="width:${pct}%"></div>
              </div>
            </div>
          `;
        }).join('');

        document.querySelectorAll('.path-item').forEach(function(item) {
          item.addEventListener('click', function(this: HTMLElement) {
            selectPath(this.getAttribute('data-path-id')!);
          });
        });
      }

      function selectPath(id: string) {
        selectedPathId = id;
        renderPathsList();
        renderPathDetail();
      }

      function renderPathDetail() {
        const container = document.getElementById('path-detail')!;
        const path = paths.find((p: Path) => p.id === selectedPathId);
        if (!path) {
          container.innerHTML = `
            <div class="path-detail-empty">
              <div class="icon">🗺️</div>
              <h3>Select or create a path</h3>
              <p>เลือก path ด้านซ้าย หรือสร้างใหม่เพื่อเริ่มวางแผนการเรียน</p>
            </div>
          `;
          return;
        }

        const total = path.courses.length;
        const done = path.completed ? path.completed.length : 0;
        const pct = total > 0 ? Math.round((done / total) * 100) : 0;
        const isComplete = total > 0 && done === total;

        let html = `
          <div class="path-detail-header">
            <div>
              <div class="path-detail-title">${esc(path.name)}</div>
              <div class="path-detail-desc">${esc(path.desc || 'No description')} · ${done}/${total} completed · ${pct}%</div>
            </div>
            <div class="path-detail-actions">
              <button class="btn-sm" id="btnReset">Reset progress</button>
              <button class="btn-sm danger" id="btnDelete">Delete</button>
            </div>
          </div>
        `;

        html += `
          <div class="achievement-badge ${isComplete ? 'visible' : ''}">
            <div class="achievement-icon">🏆</div>
            <div class="achievement-text">
              <strong>Path Complete!</strong>
              คุณทำครบทุกคอร์สใน "${esc(path.name)}" แล้ว — เก่งมาก!
            </div>
          </div>
        `;

        html += '<div class="course-sequence">';
        if (path.courses.length === 0) {
          html += '<div style="padding:24px 0;text-align:center;color:var(--muted);font-size:14px;">ยังไม่มีคอร์ส — เพิ่มด้านล่าง</div>';
        } else {
          path.courses.forEach((courseId: string, i: number) => {
            const course = COURSES.find(c => c.id === courseId);
            if (!course) return;
            const isDone = path.completed && path.completed.includes(courseId);
            html += `
              <div class="sequence-item">
                <div class="sequence-check ${isDone ? 'done' : ''}" data-course-id="${courseId}"></div>
                <div class="sequence-body">
                  <div class="sequence-num">${String(i + 1).padStart(2, '0')}</div>
                  <div class="sequence-title">${esc(course.title)}</div>
                  <div class="sequence-meta">${course.tag} · ${course.duration}</div>
                </div>
                <button class="sequence-remove" data-remove-id="${courseId}" title="Remove">×</button>
              </div>
            `;
          });
        }
        html += '</div>';

        html += `
          <div class="add-course-section">
            <div class="add-course-label">Add courses to this path</div>
            <div class="add-course-grid">
              ${COURSES.filter(c => !path.courses.includes(c.id)).map(c => `
                <button class="add-course-btn" data-add-id="${c.id}">
                  <span class="plus">+</span>
                  <span>${esc(c.title)}</span>
                </button>
              `).join('')}
            </div>
          </div>
        `;

        container.innerHTML = html;

        container.querySelectorAll('.sequence-check').forEach(function(el) {
          el.addEventListener('click', function(this: HTMLElement) {
            toggleCourse(this.getAttribute('data-course-id')!);
          });
        });

        container.querySelectorAll('.sequence-remove').forEach(function(el) {
          el.addEventListener('click', function(this: HTMLElement) {
            removeCourse(this.getAttribute('data-remove-id')!);
          });
        });

        container.querySelectorAll('.add-course-btn').forEach(function(el) {
          el.addEventListener('click', function(this: HTMLElement) {
            addCourse(this.getAttribute('data-add-id')!);
          });
        });

        document.getElementById('btnReset')!.addEventListener('click', resetProgress);
        document.getElementById('btnDelete')!.addEventListener('click', deletePath);
      }

      function openModal() {
        document.getElementById('modal-overlay')!.classList.add('open');
        (document.getElementById('path-name') as HTMLInputElement).focus();
      }
      function closeModal() {
        document.getElementById('modal-overlay')!.classList.remove('open');
        (document.getElementById('path-name') as HTMLInputElement).value = '';
        (document.getElementById('path-desc') as HTMLTextAreaElement).value = '';
      }
      function savePath() {
        const name = (document.getElementById('path-name') as HTMLInputElement).value.trim();
        if (!name) return;
        const desc = (document.getElementById('path-desc') as HTMLTextAreaElement).value.trim();
        const newPath: Path = {
          id: 'path_' + Date.now(),
          name,
          desc,
          courses: [],
          completed: [],
          created: new Date().toISOString()
        };
        paths.push(newPath);
        savePaths(paths);
        selectedPathId = newPath.id;
        closeModal();
        renderPathsList();
        renderPathDetail();
      }
      function addCourse(courseId: string) {
        const path = paths.find((p: Path) => p.id === selectedPathId);
        if (!path || path.courses.includes(courseId)) return;
        path.courses.push(courseId);
        savePaths(paths);
        renderPathsList();
        renderPathDetail();
      }
      function removeCourse(courseId: string) {
        const path = paths.find((p: Path) => p.id === selectedPathId);
        if (!path) return;
        path.courses = path.courses.filter((c: string) => c !== courseId);
        path.completed = (path.completed || []).filter((c: string) => c !== courseId);
        savePaths(paths);
        renderPathsList();
        renderPathDetail();
      }
      function toggleCourse(courseId: string) {
        const path = paths.find((p: Path) => p.id === selectedPathId);
        if (!path) return;
        if (!path.completed) path.completed = [];
        const idx = path.completed.indexOf(courseId);
        if (idx >= 0) path.completed.splice(idx, 1);
        else path.completed.push(courseId);
        savePaths(paths);
        renderPathsList();
        renderPathDetail();
      }
      function resetProgress() {
        const path = paths.find((p: Path) => p.id === selectedPathId);
        if (!path) return;
        path.completed = [];
        savePaths(paths);
        renderPathsList();
        renderPathDetail();
      }
      function deletePath() {
        if (!confirm('Delete this path?')) return;
        paths = paths.filter((p: Path) => p.id !== selectedPathId);
        selectedPathId = null;
        savePaths(paths);
        renderPathsList();
        renderPathDetail();
      }

      document.getElementById('btnNewPath')!.addEventListener('click', openModal);
      document.getElementById('modalCancel')!.addEventListener('click', closeModal);
      document.getElementById('modalSave')!.addEventListener('click', savePath);

      renderPathsList();
      renderPathDetail();

      if (paths.length === 0) {
        paths.push({
          id: 'path_demo',
          name: 'Road to Frontend Developer',
          desc: 'เรียนตั้งแต่พื้นฐานจนถึงสร้าง web app ได้จริง',
          courses: ['js-fundamentals', 'css-grid', 'react-basics', 'react-leaflet', 'tailwind-css'],
          completed: ['js-fundamentals', 'css-grid'],
          created: new Date().toISOString()
        });
        savePaths(paths);
        selectedPathId = 'path_demo';
        renderPathsList();
        renderPathDetail();
      }
    </script>

  </body>
</html>