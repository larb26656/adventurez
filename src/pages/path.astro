---
import Layout from "../components/Layout.astro";
---

<Layout title="adventurez — Learning Paths" active="Paths">
  <div class="coming-soon-page">
    <div class="coming-soon-badge">Coming Soon</div>
    <h1><span class="italic-accent">Chart your</span> own route</h1>
    <p>
      กำลังสร้างฟีเจอร์ Learning Path — เลือกคอร์สเรียงลำดับ ตั้งเป้าหมาย
      แล้วค่อยๆ ทำทีละขั้น<br />
      ไว้เจอกันเร็วๆ นี้ 🚀
    </p>
  </div>

  <style>
    .coming-soon-page {
      max-width: 700px;
      margin: 0 auto;
      padding: 80px 24px;
      text-align: center;
    }
    .coming-soon-badge {
      display: inline-block;
      font: 700 12px/1 var(--font-body);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--accent);
      background: var(--accent-dim);
      padding: 6px 16px;
      border-radius: 999px;
      margin-bottom: 24px;
    }
    .coming-soon-page h1 {
      font: 800 clamp(32px, 5vw, 48px)/1.1 var(--font-display);
      letter-spacing: -0.02em;
      margin-bottom: 16px;
    }
    .coming-soon-page h1 .italic-accent {
      font-family: var(--font-heading);
      font-style: italic;
      font-weight: 400;
    }
    .coming-soon-page p {
      font: 17px/1.7 var(--font-body);
      color: var(--muted);
      max-width: 480px;
      margin: 0 auto;
    }

    @media (max-width: 480px) {
      .coming-soon-page {
        padding: 48px 16px;
      }
      .coming-soon-page p {
        font-size: 15px;
      }
    }
  </style>
</Layout>
