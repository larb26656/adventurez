---
import Layout from '../../../components/Layout.astro';
import WorkaroundList from '../../../components/WorkaroundList.astro';
import { getWorkarounds, getWorkaroundTags } from '../../../data/workarounds';

export async function getStaticPaths() {
  const workarounds = await getWorkarounds();
  return [...getWorkaroundTags(workarounds)].map(([slug, tag]) => ({
    params: { tag: slug },
    props: { tag, workarounds: workarounds.filter((item) => item.tags.includes(tag)) },
  }));
}

const { tag, workarounds } = Astro.props;
---

<Layout title={`Workarounds: ${tag}`} active="Workarounds">
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 md:px-8 lg:px-12 pt-8 sm:pt-12">
    <a href="/workarounds/" class="inline-block mb-4 text-emerald-600 hover:underline focus-visible:outline-2 focus-visible:outline-emerald-600">← กลับไป Workarounds ทั้งหมด</a>
    <h1 class="font-bold text-[clamp(28px,5vw,40px)] leading-[1.15] tracking-tight text-foreground mb-2" style="font-family: var(--font-display); letter-spacing: -0.02em;">Workarounds: {tag}</h1>
  </div>
  <WorkaroundList workarounds={workarounds} />
</Layout>
