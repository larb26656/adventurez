---
import Layout from "../components/Layout.astro";
import CourseCard from "../components/CourseCard.astro";
import { getCourses } from "../data/courses";

const courses = await getCourses();

const TAG_TO_CATEGORY: Record<string, string> = {
  React: "webdev",
  Frontend: "webdev",
  JavaScript: "webdev",
  Docker: "backend",
  Kubernetes: "backend",
  "CI/CD": "backend",
  Jenkins: "backend",
  Github: "backend",
  Action: "backend",
  n8n: "ai",
  Automation: "ai",
  NoCode: "ai",
  Opencode: "ai",
  "AI-agent": "ai",
  LLM: "ai",
  script: "backend",
  Container: "backend",
};

function getCategory(tags: string[]): string {
  for (const tag of tags) {
    if (TAG_TO_CATEGORY[tag]) return TAG_TO_CATEGORY[tag];
  }
  return "webdev";
}
---

<Layout title="adventurez — Explore Courses" active="Courses">
  <div class="page-header">
    <h1>Explore all courses</h1>
    <p>
      Text-based, free, open-source. Filter by category, level, or duration to
      find your next adventure.
    </p>
  </div>

  <div class="explore">
    <div class="explore-layout">
      <aside class="filter-panel">
        <div class="filter-title">
          Filters
          <button class="filter-reset" id="filterReset">Reset</button>
        </div>

        <input
          type="text"
          class="filter-search"
          id="filterSearch"
          placeholder="Search courses..."
        />

        <div class="filter-group">
          <div class="filter-group-label">Category</div>
          <div
            class="filter-option active"
            data-filter="category"
            data-value="all"
          >
            <div class="filter-checkbox"></div>
            <span>All</span>
            <span class="filter-count">{courses.length}</span>
          </div>
          <div class="filter-option" data-filter="category" data-value="webdev">
            <div class="filter-checkbox"></div>
            <span>Web Dev</span>
            <span class="filter-count">{courses.filter(c => getCategory(c.tags) === 'webdev').length}</span>
          </div>
          <div class="filter-option" data-filter="category" data-value="ai">
            <div class="filter-checkbox"></div>
            <span>AI / Automation</span>
            <span class="filter-count">{courses.filter(c => getCategory(c.tags) === 'ai').length}</span>
          </div>
          <div class="filter-option" data-filter="category" data-value="backend">
            <div class="filter-checkbox"></div>
            <span>Backend / DevOps</span>
            <span class="filter-count">{courses.filter(c => getCategory(c.tags) === 'backend').length}</span>
          </div>
        </div>

        <div class="filter-group">
          <div class="filter-group-label">Status</div>
          <div class="filter-option active" data-filter="status" data-value="all">
            <div class="filter-checkbox"></div>
            <span>All</span>
          </div>
          <div class="filter-option" data-filter="status" data-value="available">
            <div class="filter-checkbox"></div>
            <span>Available</span>
          </div>
          <div class="filter-option" data-filter="status" data-value="coming-soon">
            <div class="filter-checkbox"></div>
            <span>Coming Soon</span>
          </div>
        </div>
      </aside>

      <div>
        <div class="active-filters" id="activeFilters"></div>
        <div class="results-count" id="resultsCount">
          Showing <strong>{courses.length}</strong> courses
        </div>
        <div class="course-grid" id="courseGrid">
          {courses.map((course, index) => (
            <div
              class="course-card-wrapper"
              data-category={getCategory(course.tags)}
              data-status={course.comingSoon ? "coming-soon" : "available"}
              data-title={course.title.toLowerCase()}
            >
              <CourseCard 
                title={course.title}
                tag={course.tags[0] || "Adventure"}
                thumbnail={course.thumbnail}
                href={course.comingSoon ? "#" : course.href}
                level={course.comingSoon ? "Coming Soon" : "Available"}
                duration={course.tags.slice(0, 2).join(" · ")}
                price={course.comingSoon ? "Soon" : "Free"}
              />
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <script>
    (function () {
      var filters: Record<string, string> = {
        category: "all",
        status: "all",
      };
      var searchQuery = "";

      function applyFilters() {
        var cards = document.querySelectorAll<HTMLElement>(".course-card-wrapper");
        var visible = 0;

        cards.forEach(function (card) {
          var cat = card.getAttribute("data-category");
          var status = card.getAttribute("data-status");
          var title = card.getAttribute("data-title") || "";

          var matchCat = filters.category === "all" || cat === filters.category;
          var matchStatus = filters.status === "all" || status === filters.status;
          var matchSearch = !searchQuery || title.indexOf(searchQuery) > -1;

          if (matchCat && matchStatus && matchSearch) {
            card.classList.remove("hidden");
            visible++;
          } else {
            card.classList.add("hidden");
          }
        });

        document.getElementById("resultsCount")!.innerHTML =
          "Showing <strong>" +
          visible +
          "</strong> course" +
          (visible !== 1 ? "s" : "");

        var noResults = document.querySelector(".no-results");
        if (visible === 0 && !noResults) {
          var div = document.createElement("div");
          div.className = "no-results";
          div.innerHTML =
            "<strong>No courses found</strong>Try adjusting your filters";
          document.getElementById("courseGrid")!.appendChild(div);
        } else if (visible > 0 && noResults) {
          noResults.remove();
        }

        updateActivePills();
      }

      function updateActivePills() {
        var container = document.getElementById("activeFilters")!;
        container.innerHTML = "";

        var labels: Record<string, Record<string, string>> = {
          category: {
            webdev: "Web Dev",
            ai: "AI / Automation",
            backend: "Backend / DevOps",
          },
          status: {
            available: "Available",
            "coming-soon": "Coming Soon",
          },
        };

        Object.keys(filters).forEach(function (key) {
          if (filters[key] !== "all" && labels[key] && labels[key][filters[key]]) {
            var pill = document.createElement("button");
            pill.className = "filter-pill";
            pill.innerHTML =
              labels[key][filters[key]] + ' <span class="pill-x">×</span>';
            pill.addEventListener("click", function () {
              filters[key] = "all";
              document
                .querySelectorAll('.filter-option[data-filter="' + key + '"]')
                .forEach(function (opt) {
                  opt.classList.toggle(
                    "active",
                    opt.getAttribute("data-value") === "all",
                  );
                });
              applyFilters();
            });
            container.appendChild(pill);
          }
        });
      }

      document.querySelectorAll(".filter-option").forEach(function (opt) {
        opt.addEventListener("click", function (this: HTMLElement) {
          var group = this.getAttribute("data-filter")!;
          var value = this.getAttribute("data-value")!;

          document
            .querySelectorAll('.filter-option[data-filter="' + group + '"]')
            .forEach(function (sibling) {
              sibling.classList.remove("active");
            });
          this.classList.add("active");
          filters[group] = value;
          applyFilters();
        });
      });

      (
        document.getElementById("filterSearch") as HTMLInputElement
      ).addEventListener("input", function (this: HTMLInputElement) {
        searchQuery = this.value.toLowerCase().trim();
        applyFilters();
      });

      document
        .getElementById("filterReset")!
        .addEventListener("click", function () {
          filters = { category: "all", status: "all" };
          searchQuery = "";
          (document.getElementById("filterSearch") as HTMLInputElement).value =
            "";
          document.querySelectorAll(".filter-option").forEach(function (opt) {
            opt.classList.toggle(
              "active",
              opt.getAttribute("data-value") === "all",
            );
          });
          applyFilters();
        });
    })();
  </script>
</Layout>