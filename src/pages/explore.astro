    <script>
      (function() {
        var filters: Record<string, string> = { category: 'all', level: 'all', duration: 'all' };
        var searchQuery = '';

        function applyFilters() {
          var cards = document.querySelectorAll<HTMLElement>('.course-card');
          var visible = 0;

          cards.forEach(function(card) {
            var cat = card.getAttribute('data-category');
            var lvl = card.getAttribute('data-level');
            var dur = card.getAttribute('data-duration');
            var title = card.querySelector('.course-title')!.textContent!.toLowerCase();

            var matchCat = filters.category === 'all' || cat === filters.category;
            var matchLvl = filters.level === 'all' || lvl === filters.level;
            var matchDur = filters.duration === 'all' || dur === filters.duration;
            var matchSearch = !searchQuery || title.indexOf(searchQuery) > -1;

            if (matchCat && matchLvl && matchDur && matchSearch) {
              card.classList.remove('hidden');
              visible++;
            } else {
              card.classList.add('hidden');
            }
          });

          document.getElementById('resultsCount')!.innerHTML = 'Showing <strong>' + visible + '</strong> course' + (visible !== 1 ? 's' : '');

          var noResults = document.querySelector('.no-results');
          if (visible === 0 && !noResults) {
            var div = document.createElement('div');
            div.className = 'no-results';
            div.innerHTML = '<strong>No courses found</strong>Try adjusting your filters';
            document.getElementById('courseGrid')!.appendChild(div);
          } else if (visible > 0 && noResults) {
            noResults.remove();
          }

          updateActivePills();
        }

        function updateActivePills() {
          var container = document.getElementById('activeFilters')!;
          container.innerHTML = '';

          var labels: Record<string, Record<string, string>> = {
            category: { webdev: 'Web Dev', backend: 'Backend', gamedev: 'Game Dev', ai: 'AI / ML', data: 'Data', web3: 'Web3' },
            level: { beginner: 'Beginner', intermediate: 'Intermediate', advanced: 'Advanced' },
            duration: { short: 'Under 2 hrs', medium: '2–4 hrs', long: '4+ hrs' }
          };

          Object.keys(filters).forEach(function(key) {
            if (filters[key] !== 'all' && labels[key] && labels[key][filters[key]]) {
              var pill = document.createElement('button');
              pill.className = 'filter-pill';
              pill.innerHTML = labels[key][filters[key]] + ' <span class="pill-x">×</span>';
              pill.addEventListener('click', function() {
                filters[key] = 'all';
                document.querySelectorAll('.filter-option[data-filter="' + key + '"]').forEach(function(opt) {
                  opt.classList.toggle('active', opt.getAttribute('data-value') === 'all');
                });
                applyFilters();
              });
              container.appendChild(pill);
            }
          });
        }

        document.querySelectorAll('.filter-option').forEach(function(opt) {
          opt.addEventListener('click', function(this: HTMLElement) {
            var group = this.getAttribute('data-filter')!;
            var value = this.getAttribute('data-value')!;

            document.querySelectorAll('.filter-option[data-filter="' + group + '"]').forEach(function(sibling) {
              sibling.classList.remove('active');
            });
            this.classList.add('active');
            filters[group] = value;
            applyFilters();
          });
        });

        (document.getElementById('filterSearch') as HTMLInputElement).addEventListener('input', function(this: HTMLInputElement) {
          searchQuery = this.value.toLowerCase().trim();
          applyFilters();
        });

        document.getElementById('filterReset')!.addEventListener('click', function() {
          filters = { category: 'all', level: 'all', duration: 'all' };
          searchQuery = '';
          (document.getElementById('filterSearch') as HTMLInputElement).value = '';
          document.querySelectorAll('.filter-option').forEach(function(opt) {
            opt.classList.toggle('active', opt.getAttribute('data-value') === 'all');
          });
          applyFilters();
        });
      })();
    </script>

