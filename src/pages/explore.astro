---
import Layout from "../components/Layout.astro";
import CourseFilter from "../components/CourseFilter";
import { getCourses } from "../data/courses";

const courses = await getCourses();
---

<Layout title="adventurez — Explore Courses" active="Courses">
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 md:px-8 lg:px-12 pt-8 sm:pt-12">
    <h1 class="font-bold text-[clamp(28px,5vw,40px)] leading-[1.15] tracking-tight text-foreground mb-2" style="font-family: var(--font-display); letter-spacing: -0.02em;">
      Explore all courses
    </h1>
    <p class="text-[15px] sm:text-[16px] leading-[1.6] text-muted max-w-[480px]">
      Text-based, free, open-source. Filter by category, level, or duration to
      find your next adventure.
    </p>
  </div>

  <CourseFilter client:load courses={courses} />
</Layout>
