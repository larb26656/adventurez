---
import Layout from "../components/Layout.astro";
import CourseFilter from "../components/CourseFilter";
import { getCourses } from "../data/courses";

const courses = await getCourses();
---

<Layout title="Explore Courses" active="Courses">
  <div
    class="max-w-[1100px] mx-auto px-4 sm:px-6 md:px-8 lg:px-12 pt-8 sm:pt-12"
  >
    <h1
      class="font-bold text-[clamp(28px,5vw,40px)] leading-[1.15] tracking-tight text-foreground mb-2"
      style="font-family: var(--font-display); letter-spacing: -0.02em;"
    >
      Explore all courses
    </h1>
    <p
      class="text-[15px] sm:text-[16px] leading-[1.6] text-muted max-w-[480px]"
    >
      ค้นหาคอร์สที่ใช่ แล้วเริ่มผจญภัยไปด้วยกัน ✨
    </p>
  </div>

  <CourseFilter client:load courses={courses} />
</Layout>
