---
import "../styles/game-cartridge.css";
import { getCourses } from "../data/courses";
import GameCartridgeGrid from "../components/GameCartridgeGrid";

const courses = await getCourses();
const title = "Adventurez";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <div>
      <GameCartridgeGrid courses={courses} client:load />
    </div>
  </body>
</html>
