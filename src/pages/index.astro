---
import Layout from "../components/Layout.astro";
import Stats from "../components/Stats.astro";
import CourseCard from "../components/CourseCard";
import { getCourses } from "../data/courses";

const courses = await getCourses();
---

<Layout title="adventurez — Explore Courses" active="Home">
  <div class="hero">
    <div class="hero-content">
      <div class="hero-badge">
        <span>🗺️</span> Free forever · Text-based courses
      </div>
      <h1>
        <span class="italic-accent">The new way to learn</span>
        <span>something</span>
      </h1>
      <p>
        คอร์สแบบ text-based ล้วนๆ ที่ทุกคนเข้าถึงได้ — ไม่ต้องดูวิดีโอ
        ไม่ต้องมีพื้นฐาน อ่านแล้วลงมือทำได้เลย พร้อม community
        ที่ช่วยกันเขียนเนื้อหา
      </p>
      <div class="hero-actions">
        <a href="#explore" class="btn-primary">Explore courses →</a>
        <button class="btn-secondary">How it works</button>
      </div>
    </div>
    <div class="hero-visual">
      <div class="pixel-scene">
        <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="32" height="20" fill="#e8dcc8"></rect>
          <rect x="0" y="20" width="32" height="12" fill="#5b8a72"></rect>
          <rect x="0" y="20" width="32" height="2" fill="#6b9a82"></rect>
          <rect x="8" y="16" width="16" height="4" fill="#8b6914"></rect>
          <rect x="6" y="18" width="20" height="2" fill="#8b6914"></rect>
          <rect x="15" y="4" width="2" height="12" fill="#5c4a1e"></rect>
          <rect x="17" y="5" width="6" height="8" fill="#f5f0e8"></rect>
          <rect x="17" y="5" width="6" height="1" fill="#e8dcc8"></rect>
          <rect x="17" y="4" width="3" height="2" fill="#c45a32"></rect>
          <rect x="12" y="10" width="2" height="2" fill="#d4a574"></rect>
          <rect x="12" y="8" width="2" height="2" fill="#f5e6d0"></rect>
          <rect x="11" y="7" width="4" height="1" fill="#2c2c2c"></rect>
          <rect x="11" y="12" width="4" height="4" fill="#3a5a8c"></rect>
          <rect x="15" y="11" width="3" height="1" fill="#c4a44a"></rect>
          <rect x="17" y="11" width="1" height="1" fill="#e8c84a"></rect>
          <rect x="2" y="22" width="3" height="1" fill="#7baa92"></rect>
          <rect x="10" y="24" width="4" height="1" fill="#7baa92"></rect>
          <rect x="22" y="23" width="3" height="1" fill="#7baa92"></rect>
          <rect x="28" y="25" width="2" height="1" fill="#7baa92"></rect>
          <rect x="26" y="3" width="4" height="4" fill="#e8c84a"></rect>
          <rect x="25" y="4" width="1" height="2" fill="#e8c84a"></rect>
          <rect x="30" y="4" width="1" height="2" fill="#e8c84a"></rect>
          <rect x="26" y="2" width="4" height="1" fill="#e8c84a"></rect>
          <rect x="26" y="7" width="4" height="1" fill="#e8c84a"></rect>
        </svg>
      </div>
    </div>
  </div>

  <Stats />

  <div class="explore" id="explore">
    <div class="explore-header">
      <div>
        <div class="explore-label">All courses</div>
        <h2>Pick your next adventure</h2>
      </div>
      <a class="view-all" href="/explore">View all courses →</a>
    </div>

    <div class="course-grid">
      {
        courses
          .slice(0, 4)
          .map((course) => (
            <CourseCard
              client:load
              title={course.title}
              tag={course.tags[0] || "Adventure"}
              thumbnail={course.thumbnail}
              href={course.comingSoon ? "#" : `/${course.id}`}
              level={course.comingSoon ? "Coming Soon" : "Available"}
              duration={course.tags.slice(0, 2).join(" · ")}
              price={course.comingSoon ? "Soon" : "Free"}
            />
          ))
      }
    </div>
  </div>

  <div class="learning-path">
    <div class="learning-path-card">
      <div class="learning-path-visual">
        <div class="learning-path-scene">
          <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="24" width="32" height="8" fill="#a8c48a"></rect>
            <rect x="0" y="24" width="32" height="1" fill="#98b47a"></rect>
            <rect x="10" y="20" width="12" height="6" fill="#f5e6c8"></rect>
            <rect x="11" y="21" width="10" height="4" fill="#e8d8b8"></rect>
            <rect x="13" y="22" width="6" height="1" fill="#c45a32"></rect>
            <rect x="14" y="23" width="4" height="1" fill="#5b8a72"></rect>
            <rect x="5" y="16" width="2" height="2" fill="#d4a574"></rect>
            <rect x="5" y="14" width="2" height="2" fill="#f5e6d0"></rect>
            <rect x="5" y="13" width="2" height="1" fill="#5c3a1e"></rect>
            <rect x="4" y="18" width="4" height="5" fill="#3a8c5a"></rect>
            <rect x="8" y="19" width="2" height="1" fill="#d4a574"></rect>
            <rect x="10" y="15" width="2" height="2" fill="#c49464"></rect>
            <rect x="10" y="13" width="2" height="2" fill="#f0d8c0"></rect>
            <rect x="10" y="12" width="2" height="1" fill="#2c2c2c"></rect>
            <rect x="9" y="17" width="4" height="6" fill="#8c5a3a"></rect>
            <rect x="22" y="16" width="2" height="2" fill="#d4a574"></rect>
            <rect x="22" y="14" width="2" height="2" fill="#f5e6d0"></rect>
            <rect x="22" y="13" width="2" height="1" fill="#c4a44a"></rect>
            <rect x="21" y="18" width="4" height="5" fill="#5a3a8c"></rect>
            <rect x="20" y="19" width="1" height="1" fill="#d4a574"></rect>
            <rect x="5" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="6" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="10" y="14" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="11" y="14" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="22" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="23" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="1" y="18" width="2" height="6" fill="#5c4a1e"></rect>
            <rect x="0" y="14" width="4" height="4" fill="#4a7a3a"></rect>
            <rect x="28" y="16" width="2" height="8" fill="#5c4a1e"></rect>
            <rect x="27" y="12" width="4" height="4" fill="#4a7a3a"></rect>
            <rect x="3" y="4" width="5" height="2" fill="#f5f0e8"></rect>
            <rect x="4" y="3" width="3" height="1" fill="#f5f0e8"></rect>
            <rect x="22" y="5" width="4" height="2" fill="#f5f0e8"></rect>
            <rect x="23" y="4" width="2" height="1" fill="#f5f0e8"></rect>
            <rect x="15" y="21" width="2" height="2" fill="#c45a32"></rect>
            <rect x="16" y="20" width="1" height="1" fill="#c45a32"></rect>
          </svg>
        </div>
      </div>
      <div>
        <div class="learning-path-label">Feature</div>
        <h2>Design your own learning path</h2>
        <p>
          เลือกคอร์สเรียงลำดับเอง ตั้งเป้าหมาย แล้วค่อยๆ ทำทีละขั้น —
          ข้อมูลเก็บในเครื่อง ไม่ต้องสมัคร ไม่ต้องมีบัญชี
        </p>
        <ul class="path-steps">
          <li class="path-step">
            <div class="path-step-icon">
              <svg viewBox="0 0 24 24"
                ><circle cx="12" cy="12" r="9"></circle><line
                  x1="12"
                  y1="3"
                  x2="12"
                  y2="6"></line><line x1="12" y1="18" x2="12" y2="21"
                ></line><line x1="3" y1="12" x2="6" y2="12"></line><line
                  x1="18"
                  y1="12"
                  x2="21"
                  y2="12"></line><polygon points="12,7 13,11 12,12 11,11"
                ></polygon></svg
              >
            </div>
            <div class="path-step-text">
              <strong>สร้าง path</strong> — ตั้งชื่อแล้วอธิบายเป้าหมาย
            </div>
          </li>
          <li class="path-step">
            <div class="path-step-icon">
              <svg viewBox="0 0 24 24"
                ><path d="M12 2L2 7l10 5 10-5-10-5z"></path><path
                  d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"
                ></path></svg
              >
            </div>
            <div class="path-step-text">
              <strong>เลือกคอร์ส</strong> — เพิ่มจาก library เรียงตามลำดับที่ต้องการ
            </div>
          </li>
          <li class="path-step">
            <div class="path-step-icon">
              <svg viewBox="0 0 24 24"
                ><polyline points="20 6 9 17 4 12"></polyline></svg
              >
            </div>
            <div class="path-step-text">
              <strong>check off</strong> — ทำเสร็จแล้วกด mark progress เก็บ offline
            </div>
          </li>
          <li class="path-step">
            <div class="path-step-icon">
              <svg viewBox="0 0 24 24"
                ><path
                  d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"
                ></path><line x1="4" y1="22" x2="4" y2="15"></line></svg
              >
            </div>
            <div class="path-step-text">
              <strong>รับ badge</strong> — ครบทุกคอร์ส = achievement unlocked
            </div>
          </li>
        </ul>
        <a
          href="/path"
          class="btn-primary"
          style="display:inline-block;text-decoration:none;"
          >Build your path →</a
        >
      </div>
    </div>
  </div>

  <div class="contribute">
    <div class="contribute-card">
      <div>
        <div class="contribute-label">Community</div>
        <h2>Help write the next adventure</h2>
        <p>
          adventurez เป็น open-source project ที่ทุกคนช่วยกันสร้างเนื้อหาได้ —
          ตั้งแต่เขียนคอร์สใหม่, แก้ไขเนื้อหา, ไปจนถึงเพิ่มตัวอย่างโค้ด
        </p>
        <ul class="contribute-steps">
          <li class="contribute-step">
            <div class="step-num">1</div>
            <div class="step-text">
              <strong>Fork the repo</strong> — clone แล้วเลือก course ที่อยากเขียน
            </div>
          </li>
          <li class="contribute-step">
            <div class="step-num">2</div>
            <div class="step-text">
              <strong>เขียนเนื้อหา</strong> — text-based, markdown ล้วน ไม่มีวิดีโอ
            </div>
          </li>
          <li class="contribute-step">
            <div class="step-num">3</div>
            <div class="step-text">
              <strong>เปิด PR</strong> — community review แล้ว merge เข้า main
            </div>
          </li>
        </ul>
        <a
          href="#"
          class="btn-primary"
          style="display:inline-block;text-decoration:none;margin-top:24px;"
          >Contribute on GitHub →</a
        >
      </div>
      <div class="contribute-visual">
        <div class="contribute-scene">
          <svg viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg">
            <rect x="0" y="24" width="32" height="8" fill="#a8c48a"></rect>
            <rect x="0" y="24" width="32" height="1" fill="#98b47a"></rect>
            <rect x="10" y="20" width="12" height="6" fill="#f5e6c8"></rect>
            <rect x="11" y="21" width="10" height="4" fill="#e8d8b8"></rect>
            <rect x="13" y="22" width="6" height="1" fill="#c45a32"></rect>
            <rect x="14" y="23" width="4" height="1" fill="#5b8a72"></rect>
            <rect x="17" y="22" width="1" height="1" fill="#c45a32"></rect>
            <rect x="18" y="23" width="1" height="1" fill="#c45a32"></rect>
            <rect x="5" y="16" width="2" height="2" fill="#d4a574"></rect>
            <rect x="5" y="14" width="2" height="2" fill="#f5e6d0"></rect>
            <rect x="5" y="13" width="2" height="1" fill="#5c3a1e"></rect>
            <rect x="4" y="18" width="4" height="5" fill="#3a8c5a"></rect>
            <rect x="8" y="19" width="2" height="1" fill="#d4a574"></rect>
            <rect x="10" y="15" width="2" height="2" fill="#c49464"></rect>
            <rect x="10" y="13" width="2" height="2" fill="#f0d8c0"></rect>
            <rect x="10" y="12" width="2" height="1" fill="#2c2c2c"></rect>
            <rect x="9" y="17" width="4" height="6" fill="#8c5a3a"></rect>
            <rect x="22" y="16" width="2" height="2" fill="#d4a574"></rect>
            <rect x="22" y="14" width="2" height="2" fill="#f5e6d0"></rect>
            <rect x="22" y="13" width="2" height="1" fill="#c4a44a"></rect>
            <rect x="21" y="18" width="4" height="5" fill="#5a3a8c"></rect>
            <rect x="20" y="19" width="1" height="1" fill="#d4a574"></rect>
            <rect x="5" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="6" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="10" y="14" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="11" y="14" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="22" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="23" y="15" width="1" height="1" fill="#2c2c2c"></rect>
            <rect x="1" y="18" width="2" height="6" fill="#5c4a1e"></rect>
            <rect x="0" y="14" width="4" height="4" fill="#4a7a3a"></rect>
            <rect x="28" y="16" width="2" height="8" fill="#5c4a1e"></rect>
            <rect x="27" y="12" width="4" height="4" fill="#4a7a3a"></rect>
            <rect x="3" y="4" width="5" height="2" fill="#f5f0e8"></rect>
            <rect x="4" y="3" width="3" height="1" fill="#f5f0e8"></rect>
            <rect x="22" y="5" width="4" height="2" fill="#f5f0e8"></rect>
            <rect x="23" y="4" width="2" height="1" fill="#f5f0e8"></rect>
          </svg>
        </div>
      </div>
    </div>
  </div>
</Layout>
