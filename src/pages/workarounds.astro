---
import { getCollection } from 'astro:content';
import Layout from '../components/Layout.astro';
import WorkaroundList from '../components/WorkaroundList.astro';

const docs = await getCollection('docs', ({ id }) => id.startsWith('workaround/'));
const workarounds = docs.map(({ id, data }) => ({
  id,
  title: data.title,
  description: data.description!,
  tags: data.tags!,
  publishedAt: data.publishedAt as string,
})).sort((a, b) => b.publishedAt.localeCompare(a.publishedAt) || (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));
---

<Layout title="Workarounds" active="Workarounds">
  <div class="max-w-[1100px] mx-auto px-4 sm:px-6 md:px-8 lg:px-12 pt-8 sm:pt-12">
    <h1 class="font-bold text-[clamp(28px,5vw,40px)] leading-[1.15] tracking-tight text-foreground mb-2" style="font-family: var(--font-display); letter-spacing: -0.02em;">Workarounds</h1>
    <p class="text-[15px] sm:text-[16px] leading-[1.6] text-muted max-w-[480px]">ค้นหาวิธีทำและวิธีแก้ที่นำไปใช้ได้จริง</p>
  </div>
  <WorkaroundList workarounds={workarounds} />
</Layout>
